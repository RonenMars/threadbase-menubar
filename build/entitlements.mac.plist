<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 needs JIT to execute JavaScript. Required for hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- V8 allocates writable+executable memory for JIT-compiled code. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Some Electron internals load DYLDs at runtime; required by Electron docs. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
