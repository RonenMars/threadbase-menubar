{
	"name": "threadbase-menubar",
	"version": "0.2.0",
	"description": "Menu bar status indicator for Threadbase Streamer",
	"license": "MIT",
	"author": "Ronen Mars",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RonenMars/threadbase-menubar.git"
	},
	"main": "dist/main.js",
	"scripts": {
		"start": "npm run build && electron .",
		"build": "tsc && node scripts/copy-renderer.mjs",
		"build:icons": "./scripts/build-tray-icons.sh",
		"build:icon": "./scripts/build-app-icon.sh",
		"dev": "npm run build && electron .",
		"package:mac": "npm run build && electron-builder --mac -c electron-builder.config.js",
		"package:mac:dir": "npm run build && electron-builder --mac --dir -c electron-builder.config.js",
		"package:linux": "npm run build && electron-builder --linux -c electron-builder.config.js",
		"package:win": "npm run build && electron-builder --win -c electron-builder.config.js"
	},
	"dependencies": {
		"menubar": "^9.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/node": "^20.0.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"electron": "^28.0.0",
		"electron-builder": "^25.1.8",
		"semantic-release": "^25.0.7",
		"typescript": "^5.5.0"
	}
}
